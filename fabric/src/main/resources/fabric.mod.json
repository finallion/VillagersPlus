{
  "schemaVersion": 1,
  "id": "villagersplus",
  "version": "${version}",
  "name": "Villagers Plus",
  "description": "New villagers, new trades and new beautiful and useful workstations.",
  "authors": [
    "Finallion"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/villagersplus",
    "sources": "https://github.com/finallion/VillagersPlus",
    "issues": "https://github.com/finallion/VillagersPlus/issues"
  },

  "license": "GPL-3.0-only",
  "icon": "villagersplus_logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lion.villagersplus.fabric.VillagersPlusFabric"
    ],
    "client": [
      "com.lion.villagersplus.fabric.VillagersPlusClientFabric"
    ]
  },
  "mixins": [
    "villagersplus-fabric.mixins.json",
    "villagersplus-common.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-api": ">=0.83.0",
    "villagertradingplus": ">=1.1.0 <2",
    "minecraft": ">=1.20 <1.20.2-",
